PORT=3000
HOST="localhost"
API_URL="http://localhost:3001"

# ensure sync with komondor-api
HPC_DATASTORE_ROOT="/var/storage"

# HPC Directory Prefix - prepended to user input in HPC Directory Name field
# Development: HPC_DIRECTORY_PREFIX=~/../komondor-api/fake-mnt/tempWebUploadToSequences
# Production: HPC_DIRECTORY_PREFIX=/tsl/data/tempWebUploadToSequences
# Note: Trailing slash is optional - it will be added automatically if missing
# If not set, defaults to /tsl/data/tempWebUploadToSequences/
HPC_DIRECTORY_PREFIX=~/../komondor-api/fake-mnt/tempWebUploadToSequences

# this timestamp is for 12.15pm 11/24/2020
DATAHOG_DEATH=1606219980

# NB for nuxt process.env, please ALSO use nuxt.config.js, otherwise this is useless
