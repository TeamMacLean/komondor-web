{
  "name": "komondor",
  "version": "1.0.0",
  "description": "TSL Sequence Data",
  "author": "George Deeks",
  "private": true,
  "scripts": {
    "dev": "nuxt",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "lint": "eslint --ext .js,.vue pages components utils plugins store middleware layouts tests *.js",
    "lint:fix": "npm run lint -- --fix",
    "pm2": "pm2 start npm --name komondor-web -- start",
    "start": "nuxt start",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mdi/font": "^5.8.55",
    "@nuxtjs/auth": "^4.9.1",
    "@nuxtjs/axios": "^5.13.6",
    "@nuxtjs/pwa": "^3.3.2",
    "@uppy/core": "^1.14.1",
    "@uppy/dashboard": "^1.13.0",
    "@uppy/drag-drop": "^1.4.21",
    "@uppy/file-input": "^1.4.19",
    "@uppy/thumbnail-generator": "^1.7.1",
    "@uppy/tus": "^1.8.0",
    "bulma": "^0.9.1",
    "bulma-tooltip": "^3.0.2",
    "dotenv": "^8.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.27.0",
    "identicon.js": "^2.3.3",
    "lodash": "^4.17.20",
    "moment": "^2.29.1",
    "nuxt": "^2.18.1",
    "nuxt-buefy": "^0.4.4",
    "nuxt-compress": "^4.1.0",
    "nuxt-fontawesome": "^0.4.0",
    "papaparse": "^5.5.3",
    "prettier": "^2.2.1",
    "sass": "^1.77.8",
    "sass-loader": "^10.5.2",
    "spark-md5": "^3.0.2",
    "uuid": "^8.3.1",
    "v-tooltip": "^2.0.3",
    "vue-clipboard2": "^0.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-vue2": "^2.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/test-utils": "^1.3.6",
    "dotenv-cli": "^11.0.0",
    "happy-dom": "^20.0.10",
    "jsdom": "^27.0.1",
    "vitest": "^3.2.4"
  }
}
